# =====================================================================
# Yuán MVP — Environment variables (example)
# Copy this file to `.env.local` and fill in values for local dev.
# Never commit `.env.local` (it is git-ignored).
# =====================================================================

# ----- Anthropic (Claude Vision for document intake) -----
ANTHROPIC_API_KEY=sk-ant-...

# ----- Clerk (auth + organizations) -----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ----- BSC testnet (escrow contracts) -----
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_TESTNET_CHAIN_ID=97
DEPLOYER_PRIVATE_KEY=0x... # burner wallet for deploys (testnet only)
ARBITER_PRIVATE_KEY=0x...  # arbiter EOA (testnet only)
BSCSCAN_API_KEY=YOUR_BSCSCAN_KEY # optional, for contract verify

# ----- Deployed contract addresses (set after Phase 5 deploy) -----
NEXT_PUBLIC_MOCK_USDT_ADDRESS=0x...
NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=0x...

# ----- SOR service (local FastAPI uvicorn) -----
SOR_SERVICE_URL=http://localhost:8000
